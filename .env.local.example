# ==============================================================================
# SUPER MÁS ERP/POS — VARIABLES DE ENTORNO (PLANTILLA)
# Copie este archivo como .env.local y complete los valores. Nunca suba .env.local al repositorio.
# Aquí solo van secretos y parámetros de entorno: los datos fiscales NO secretos (emisor,
# resolución, prefijo, rango, Software ID, TestSetId) viven en la base de datos
# (public.companies, public.dian_resolutions, public.dian_software_config) y se editan en el ERP.
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE
# ------------------------------------------------------------------------------
# Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Project Settings -> API -> anon public (pública, protegida por RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings -> API -> service_role (SECRETA: solo servidor, nunca con prefijo NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Conexión directa a PostgreSQL (solo scripts de backend / migraciones)
DATABASE_URL=
DIRECT_URL=

# ------------------------------------------------------------------------------
# APLICACIÓN
# ------------------------------------------------------------------------------
# URL pública del ERP (enlaces de restablecimiento de contraseña)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Orígenes (separados por comas) autorizados por CORS para consumir /api/public/* desde la tienda web.
# Vacío = catálogo público abierto a cualquier origen (solo expone productos publicados, sin costos ni stock exacto).
# Ejemplo: PUBLIC_CATALOG_ALLOWED_ORIGINS=https://www.supermas.com.co,https://distribuidora.supermas.com.co
PUBLIC_CATALOG_ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# SCRIPTS DE STAGING Y PRUEBAS E2E (scripts/*.ts). Nunca usar contraseñas reales de producción.
# ------------------------------------------------------------------------------
# Contraseña del usuario de staging con el que se autentican los scripts de prueba.
STAGING_AUTH_PASSWORD=
# Contraseña inicial que asigna scripts/setup-clean-production-staging.ts al administrador.
STAGING_ADMIN_INITIAL_PASSWORD=
# Contraseña de los usuarios temporales que crean las pruebas E2E (fases 12 a 21).
E2E_TEST_USER_PASSWORD=

# ==============================================================================
# FACTURACIÓN ELECTRÓNICA DIAN — SOFTWARE PROPIO (Anexo Técnico 1.9)
# Leídas por features/invoices/services/dian/dian.config.ts (solo servidor).
# ==============================================================================

# Ambiente: HABILITACION | PRODUCCION. PRODUCCION está bloqueado durante la fase de habilitación.
DIAN_ENVIRONMENT=HABILITACION

# PIN del software propio (portal DIAN de habilitación). SECRETO.
DIAN_SOFTWARE_PIN=

# Clave técnica del set de pruebas (cálculo del CUFE en habilitación). SECRETO.
DIAN_TEST_TECHNICAL_KEY=

# Clave técnica de producción. Dejar vacía hasta que se autorice el paso a producción. SECRETO.
DIAN_PRODUCTION_TECHNICAL_KEY=

# Certificado digital .p12/.pfx en Base64 y su contraseña. SECRETOS.
DIAN_CERTIFICATE_BASE64=
DIAN_CERTIFICATE_PASSWORD=

# Opcionales: el código ya trae los endpoints oficiales de habilitación.
# DIAN_HABILITACION_WS_URL=https://vpfe-hab.dian.gov.co/WcfDianCustomerServices.svc
# DIAN_HABILITACION_QR_URL=https://catalogo-vpfe-hab.dian.gov.co/document/searchqr?documentkey=
# Tiempo máximo de espera de la DIAN en milisegundos (por defecto 60000).
# DIAN_HTTP_TIMEOUT_MS=60000
