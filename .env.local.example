# ==============================================================================
# VARIABLES DE ENTORNO REQUERIDAS - SUPABASE POSTGRESQL (SUPER MÁS ERP/POS)
# ==============================================================================

# URL base del proyecto Supabase
# Ubicación en Supabase Dashboard: Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anónima pública (Segura para componentes de navegador y clientes React)
# Ubicación en Supabase Dashboard: Project Settings -> API -> Project API keys -> anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clave Service Role Secreta (NUNCA exponer en frontend ni con prefijo NEXT_PUBLIC_*)
# Usada exclusivamente en scripts de migración, cron jobs, webhooks seguros y server-side admin
# Ubicación en Supabase Dashboard: Project Settings -> API -> Project API keys -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Conexión directa a PostgreSQL (Solo backend / migraciones / seed)
DATABASE_URL=postgresql://postgres.xxx:xxx@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DIRECT_URL=postgresql://postgres.xxx:xxx@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# Configuración Operativa General
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_TIMEZONE=America/Bogota

# ==============================================================================
# FACTURACIÓN ELECTRÓNICA DIAN — ANEXO TÉCNICO 1.9 (SOFTWARE PROPIO)
# ==============================================================================

# ------------------------------------------------------------------------------
# AMBIENTE FISCAL (OBLIGATORIO: Mantener en HABILITACION durante esta fase)
# Valores permitidos: HABILITACION | PRODUCCION
# NOTA: El sistema bloquea automáticamente cualquier intento de transmisión a PRODUCCION.
# ------------------------------------------------------------------------------
DIAN_ENVIRONMENT=HABILITACION

# ------------------------------------------------------------------------------
# DIAN - IDENTIFICACIÓN DEL FACTURADOR ELECTRÓNICO (SUPER MÁS S.A.S.)
# Debe coincidir exactamente con el Registro Único Tributario (RUT).
# ------------------------------------------------------------------------------
DIAN_NIT=901458789
DIAN_DV=2
DIAN_COMPANY_NAME=DISTRIBUIDORA SUPER MAS S.A.S.
DIAN_COMPANY_EMAIL=facturacion@supermas.com.co

# ------------------------------------------------------------------------------
# DIAN - CERTIFICADO DIGITAL X.509
# Certificado emitido por entidad de certificación digital abierta autorizada por ONAC.
# El archivo .p12/.pfx debe convertirse a Base64 para inyección segura en variable de entorno.
# NUNCA colocar en repositorio ni exponer al frontend.
# ------------------------------------------------------------------------------
DIAN_CERTIFICATE_BASE64=
DIAN_CERTIFICATE_PASSWORD=

# ------------------------------------------------------------------------------
# DIAN - AMBIENTE DE HABILITACIÓN (SOFTWARE PROPIO)
# Datos generados por la DIAN en el portal de Habilitación al registrar el Software Propio.
# ------------------------------------------------------------------------------
DIAN_SOFTWARE_ID=
DIAN_SOFTWARE_PIN=
DIAN_TEST_SET_ID=

# URLs del Software del Facturador registradas en el catálogo de participantes de la DIAN:
# - DIAN_SOFTWARE_URL: URL pública del software Super Más ERP
# - DIAN_RECEPTION_URL: URL registrada ante la DIAN para recepción de facturas electrónicas
DIAN_SOFTWARE_URL=https://erp.supermas.com.co
DIAN_RECEPTION_URL=https://erp.supermas.com.co/api/dian/reception

# Endpoints oficiales del WebService SOAP DIAN para Habilitación:
DIAN_HABILITACION_WS_URL=https://vpfe-hab.dian.gov.co/WcfDianCustomerServices.svc
DIAN_HABILITACION_QR_URL=https://catalogo-vpfe-hab.dian.gov.co/document/searchqr?documentkey=

# ------------------------------------------------------------------------------
# DIAN - NUMERACIÓN Y RANGOS DE PRUEBA (HABILITACIÓN)
# Asignados en el catálogo de pruebas de la DIAN para el software propio.
# ------------------------------------------------------------------------------
DIAN_TEST_PREFIX=SETP
DIAN_TEST_RESOLUTION_NUMBER=18760000001
DIAN_TEST_RANGE_FROM=990000000
DIAN_TEST_RANGE_TO=995000000
# Clave técnica generada por la DIAN para el set de pruebas (requerida para cálculo de CUFE)
DIAN_TEST_TECHNICAL_KEY=

# ==============================================================================
# DIAN - AMBIENTE DE PRODUCCIÓN (¡NO ACTIVAR TODAVÍA!)
# ==============================================================================
# Estos campos se completarán únicamente cuando la DIAN apruebe el Set de Pruebas
# y el usuario autorice expresamente el paso a Producción.
# ------------------------------------------------------------------------------
DIAN_PRODUCTION_SOFTWARE_ID=
DIAN_PRODUCTION_SOFTWARE_PIN=
DIAN_PRODUCTION_URL=
DIAN_PRODUCTION_RECEPTION_URL=
DIAN_PRODUCTION_WS_URL=https://vpfe.dian.gov.co/WcfDianCustomerServices.svc
DIAN_PRODUCTION_QR_URL=https://catalogo-vpfe.dian.gov.co/document/searchqr?documentkey=
DIAN_PRODUCTION_PREFIX=
DIAN_PRODUCTION_RESOLUTION_NUMBER=
DIAN_PRODUCTION_RANGE_FROM=
DIAN_PRODUCTION_RANGE_TO=
DIAN_PRODUCTION_TECHNICAL_KEY=
